%include ~/.config/dot-local/slrc.before

[ui]
username = Karl Gyllstrom <karl.gyllstrom@gmail.com>
ignore.myignore = ~/.hgignore
ignore = ~/.hgignore

[extdiff]
cmd.vimdiff =

[alias]
bo = bookmarks
pop = strip --keep -r .
ra = !$HG resolve --all --mark
mc = !$HG resolve --all --mark && $HG rebase --continue
mst = rebase -s . -d master
# filediff =!echo sup $1
filediff = !$HG status --rev `hg_revision_tag.py $1`::.
fd = filediff
fdm = !$HG status --rev `$HG log -r "ancestor(., master)" --template "{node|short}\n"`::.
touch = !$HG status --change . | sed 's?^. ??'
rc = !$HG resolve --all --mark && $HG rebase --continue
dp = !$HG diff -r `hg_revision_tag.py $1`
dpp = diff -r .^^
dpm = !$HG diff -r `$HG log -r "ancestor(., master)" --template "{node|short}\n"`
vi = !$HG fd | sed 's?^.\s??' | xargs nvim -o
getlast = !$HG my | head -1
my = !$HG sl 2> /dev/null | grep $USER | sed 's?.* \([a-z0-9]\{10\}\) .*?\1?'
last = !$HG checkout $($HG getlast)
tm = rebase -s . -d master
an = !zsh -c 'hg log -r "ancestor(.,$1)"  | head -1 | sed "s?.* \(D[^ ]*\) .*?\1?"'
#an = !zsh -c 'if [`hg log -r "ancestor(.,$1)"  | head -1 | sed "s?.* \(D[^ ]*\) .*?\1?"` = $1]; then echo 1 else echo 0; fi'
d = !$HG log -r . | head -1 | sed 's?.* D?D?' | sed 's? .*??'
p = prev
n = next
old = cloud sl
he = histedit
lc = update "max(descendants(.) and not closed())"
cur = log -r .
tag = log -r 'last(ancestors(.) & public())' -T '{join(remotenames,",")}\n'
srb = rebase -s . -d 'last(ancestors(.) & public())'
s = sl -r .

[hint]
ack = hgignore-deprecate

%include ~/.config/dot-local/slrc.after
